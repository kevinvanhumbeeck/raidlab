# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Supabase → Settings → API Keys → secret key. Used to record Discord server membership.
SUPABASE_SECRET_KEY=sb_secret_...

# Discord server whose members may use the app (Developer Mode → right-click server → Copy Server ID).
# Leave empty to allow any Discord user.
DISCORD_GUILD_ID=

# Discord roles that give access (Developer Mode → Server Settings → Roles → right-click → Copy Role ID).
# Comma-separate several IDs (e.g. raider and pug). Leave all empty to let in everyone in the server.
DISCORD_RAIDER_ROLE_ID=
# Also makes the player an officer in the app. Leave empty to manage officers in the app instead.
DISCORD_OFFICER_ROLE_ID=

# Discord bot (#49): posts raids in a channel with sign-up buttons. Leave empty to turn it off.
# Developer portal → your app → General Information (public key) and Bot (token).
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Channel for raid announcements (Developer Mode → right-click channel → Copy Channel ID).
DISCORD_RAID_CHANNEL_ID=
# Links in Discord messages. Defaults to https://www.raidlab.net.
SITE_URL=
# Sign-up reminders (#59): the reminders workflow sends this as a bearer token. Any long random string, e.g.
# `openssl rand -hex 32`; the same value goes in the GitHub secret CRON_SECRET.
CRON_SECRET=
