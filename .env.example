# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Supabase → Settings → API Keys → secret key. Used to record Discord server membership.
SUPABASE_SECRET_KEY=sb_secret_...

# Discord server whose members may use the app (Developer Mode → right-click server → Copy Server ID).
# Leave empty to allow any Discord user.
DISCORD_GUILD_ID=

# Discord roles that give access (Developer Mode → Server Settings → Roles → right-click → Copy Role ID).
# Comma-separate several IDs. Leave all empty to let in everyone in the server.
DISCORD_RAIDER_ROLE_ID=
DISCORD_PUG_ROLE_ID=
# Also makes the player an officer in the app. Leave empty to manage officers in the app instead.
DISCORD_OFFICER_ROLE_ID=
